# Copy to .env and fill in your keys — never commit the real .env
# AssemblyAI Voice Agent API key (required)
# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=your_key_here

# Mistral key for AI-drafted interview questions (optional)
# Without it, the built-in role-aware templates are used instead
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Optional: OpenAI key (alternative AI drafting backend)
# OPENAI_API_KEY=

# Set automatically by backend/server.py after the first publish
# AGENT_ID_INTERVIEWCOACH=
